.venv/
__pycache__/
*.pyc
.pytest_cache/

# Experiment output is reproducible from `make repro`; only the summaries and
# figures are worth keeping in version control.
logs/*.jsonl
logs/*_run.txt
logs/*smoke*

# Generated by experiments/make_maze_demo.py from the traces in logs/. Rebuilt with
# `make race` (all three architectures) or `make demo` (one). Each is over a megabyte of
# embedded trace, and a committed copy is a claim that ages while the Makefile target is
# one that does not.
demo/index.html
demo/single.html

.DS_Store

# Raw traces: multi-megabyte, and regenerated by `make race` / `make e9`. The compressed
# summaries next to them (logs/*_summary.json, logs/scorecard*.json) are the published
# numbers and are small enough to keep under version control.
logs/maze_race.json
logs/maze_trace.json
